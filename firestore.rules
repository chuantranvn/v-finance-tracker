rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- Entity Validations ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'phoneNumber']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 20 &&
             data.uid == request.auth.uid; // Identity Integrity
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['userId', 'symbol']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.symbol is string && data.symbol.size() <= 10 &&
             (data.get('quantity', 0) is number) &&
             (data.get('avgPrice', 0) is number);
    }

    // --- Collection Matches ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Users cannot list other users
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Update Profile Info (displayName, photoURL)
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
      );
      allow delete: if isAdmin(); // Profiles are immortal for users
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && isValidBookmark(incoming()) && isValidId(bookmarkId);
      allow update: if isOwner(userId) && isValidBookmark(incoming()) && (
        // Action: Update quantity/price
        incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'avgPrice', 'isVisible', 'autoUpdate', 'companyName'])
      );
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
