rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- Entity Validations ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'phoneNumber']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 20 &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100) &&
             (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 1000000) && // Allow large base64
             data.uid == request.auth.uid; // Identity Integrity
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['id', 'userId', 'symbol', 'shares', 'buyPrice', 'currentPrice']) &&
             data.id is string &&
             data.userId is string && data.userId == request.auth.uid &&
             data.symbol is string && data.symbol.size() <= 10 &&
             data.shares is number &&
             data.buyPrice is number &&
             data.currentPrice is number &&
             (data.get('autoUpdate', true) is bool) &&
             (data.get('isHidden', false) is bool) &&
             (data.get('timestamp', 0) is number);
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['authorId', 'content', 'createdAt']) &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.content is string && data.content.size() <= 5000 &&
             (data.get('likesCount', 0) is number) &&
             (data.get('commentsCount', 0) is number) &&
             (data.get('isHidden', false) is bool) &&
             (data.createdAt == request.time || (hasExisting() && data.createdAt == existing().createdAt));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['authorId', 'content', 'createdAt']) &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.content is string && data.content.size() <= 1000 &&
             (data.get('parentId', '') is string) &&
             (data.get('authorName', '') is string) &&
             (data.get('replyToId', '') is string) &&
             (data.get('replyToPhone', '') is string) &&
             (data.get('replyToName', '') is string) &&
             (data.get('likesCount', 0) is number) &&
             (data.createdAt == request.time || (hasExisting() && data.createdAt == existing().createdAt));
    }

    function hasExisting() { return resource != null; }

    // --- Collection Matches ---

    match /articles/{articleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidArticle(incoming()) && incoming().authorId == request.auth.uid && isValidId(articleId);
      allow update: if isSignedIn() && isValidArticle(incoming()) && incoming().authorId == existing().authorId && (
        // Action: Edit Article / Toggle Visibility (Owner only)
        (isOwner(existing().authorId) && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt', 'isHidden'])) ||
        // Action: Increment Comment Count (Anyone)
        (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount']) && incoming().commentsCount == existing().get('commentsCount', 0) + 1) ||
        // Action: Like/Unlike (Anyone)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && (
          (incoming().likesCount == existing().get('likesCount', 0) + 1 && existsAfter(/databases/$(database)/documents/articles/$(articleId)/likes/$(request.auth.uid))) ||
          (incoming().likesCount == existing().get('likesCount', 0) - 1 && !existsAfter(/databases/$(database)/documents/articles/$(articleId)/likes/$(request.auth.uid)))
        ))
      );
      allow delete: if isOwner(existing().authorId) || isAdmin();

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidComment(incoming()) && incoming().authorId == request.auth.uid && isValidId(commentId);
        allow update: if isSignedIn() && isValidComment(incoming()) && incoming().authorId == existing().authorId && (
          (isOwner(existing().authorId) && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']) && incoming().updatedAt == request.time) ||
          // Action: Like/Unlike Comment (Anyone)
          (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && (
            (incoming().likesCount == existing().get('likesCount', 0) + 1 && existsAfter(/databases/$(database)/documents/articles/$(articleId)/comments/$(commentId)/likes/$(request.auth.uid))) ||
            (incoming().likesCount == existing().get('likesCount', 0) - 1 && !existsAfter(/databases/$(database)/documents/articles/$(articleId)/comments/$(commentId)/likes/$(request.auth.uid)))
          ))
        );
        allow delete: if isOwner(existing().authorId) || isAdmin();

        match /likes/{userId} {
          allow read: if isSignedIn();
          allow create, delete: if isOwner(userId);
        }
      }
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); // Users cannot list other users
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Update Profile Info (displayName, photoURL)
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
      );
      allow delete: if isAdmin(); // Profiles are immortal for users
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && isValidBookmark(incoming()) && isValidId(bookmarkId);
      allow update: if isOwner(userId) && isValidBookmark(incoming()) && (
        // Action: Update fields
        incoming().diff(existing()).affectedKeys().hasOnly(['shares', 'buyPrice', 'currentPrice', 'symbol', 'companyName', 'autoUpdate', 'isHidden', 'timestamp'])
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.targetId == request.auth.uid;
      
      allow create: if isSignedIn() && 
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.targetId is string &&
        request.resource.data.type in ['like', 'comment', 'share'];
      
      allow update: if isSignedIn() && resource.data.targetId == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}
